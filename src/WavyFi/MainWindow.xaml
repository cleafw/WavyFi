<Window x:Class="WavyFi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WavyFi.Localization"
        xmlns:controls="clr-namespace:WavyFi.Controls"
        Title="WavyFi" Height="760" Width="1180"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#1E1E24" Foreground="#E8E8EC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="3*" MinWidth="460"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1.2*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- Quadrants 1+2 vs 3: horizontal resize -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#2C2C36" ResizeBehavior="PreviousAndNext"/>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <ToggleButton x:Name="ScanToggle" Style="{StaticResource ScanSwitchStyle}"
                          IsChecked="True" VerticalAlignment="Center"
                          Checked="ScanToggle_Changed" Unchecked="ScanToggle_Changed"
                          DockPanel.Dock="Left"/>
            <TextBlock Text="{loc:Text S0}" VerticalAlignment="Center" Margin="14,0,6,0"
                       Foreground="#8A8A94" DockPanel.Dock="Left"/>
            <ToggleButton x:Name="AdapterDropdown" Style="{StaticResource DropdownToggle}"
                          MinWidth="280" MaxWidth="420" VerticalAlignment="Center"
                          DockPanel.Dock="Left" Checked="AdapterDropdown_Opened">
                <TextBlock x:Name="AdapterSummary" Text="{loc:Text S1}"
                           TextTrimming="CharacterEllipsis"/>
            </ToggleButton>
            <Popup DockPanel.Dock="Left" PlacementTarget="{Binding ElementName=AdapterDropdown}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=AdapterDropdown, Mode=TwoWay}">
                <Border Background="#26262E" BorderBrush="#3A3A46" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, ElementName=AdapterDropdown}">
                    <ItemsControl x:Name="AdapterList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="8,5" Foreground="#E8E8EC"
                                          Checked="AdapterCheck_Changed"
                                          Unchecked="AdapterCheck_Changed">
                                    <TextBlock Text="{Binding Display}" MaxWidth="380"
                                               TextTrimming="CharacterEllipsis"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <Hyperlink NavigateUri="https://github.com/cleafw/WavyFi"
                           RequestNavigate="RepoLink_RequestNavigate"
                           ToolTip="{loc:Text S2}">
                    <Run x:Name="TitleRun" Text="WavyFi"/>
                </Hyperlink>
            </TextBlock>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Style="{StaticResource ToolButton}" Content="A−" FontSize="11"
                        ToolTip="{loc:Text S3}" Click="FontDecrease_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="A" FontSize="11" Margin="4,0,0,0"
                        ToolTip="{loc:Text S4}" Click="FontReset_Click"/>
                <Button Style="{StaticResource ToolButton}" Content="A+" FontSize="11" Margin="4,0,0,0"
                        ToolTip="{loc:Text S5}" Click="FontIncrease_Click"/>
            </StackPanel>
            <ComboBox x:Name="LanguageSelector" DockPanel.Dock="Right" Width="100"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      ToolTip="中文 / English" SelectionChanged="LanguageSelector_Changed">
                <ComboBoxItem Content="中文" Tag="zh-CN"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
            <Border/>
        </DockPanel>

        <!-- Left column: filter + table + graphs -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*" MinHeight="140"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="2*" MinHeight="160"/>
            </Grid.RowDefinitions>

            <!-- Quadrant 1 vs 2: vertical resize -->
            <GridSplitter Grid.Row="2" Height="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#2C2C36" ResizeBehavior="PreviousAndNext"/>

            <StackPanel Grid.Row="0">
                <!-- Row 1: section title + text filters. Row 2: the sliders.
                     Each filter is one StackPanel so wrapping on narrow
                     windows moves whole groups, never orphaning a value. -->
                <WrapPanel x:Name="FilterRow1" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text S6}"
                               VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Text S7}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#8A8A94"/>
                        <TextBox x:Name="SearchBox" Width="180"
                                 TextChanged="Filter_Changed"
                                 ToolTip="{loc:Text S8}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text S9}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#8A8A94"/>
                        <ComboBox x:Name="BandFilter" Width="100"
                                  SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="{loc:Text S10}"/>
                            <ComboBoxItem Content="2.4 GHz"/>
                            <ComboBoxItem Content="5 GHz"/>
                            <ComboBoxItem Content="6 GHz"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,2,0">
                        <TextBlock Text="{loc:Text S11}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#8A8A94"/>
                        <Slider x:Name="MinRssiSlider" Width="140" Minimum="-100" Maximum="-30"
                                Value="-100" VerticalAlignment="Center"
                                ToolTip="{loc:Text S12}"
                                ValueChanged="Filter_Changed"/>
                        <TextBlock x:Name="MinRssiLabel" Text="{loc:Text S13}" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Foreground="#8A8A94" MinWidth="34"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text S14}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#8A8A94"/>
                        <Slider x:Name="LastSeenSlider" Width="140" Minimum="0" Maximum="1000"
                                Value="1000" VerticalAlignment="Center"
                                ToolTip="{loc:Text S15}"
                                ValueChanged="Filter_Changed">
                            <Slider.Resources>
                                <!-- Max-age filter: the passing side is the LEFT
                                     (younger) side, so swap the track fills. -->
                                <SolidColorBrush x:Key="Slider.FillLeftBrush" Color="#3A5A8C"/>
                                <SolidColorBrush x:Key="Slider.FillRightBrush" Color="Transparent"/>
                            </Slider.Resources>
                        </Slider>
                        <TextBlock x:Name="LastSeenLabel" Text="{loc:Text S13}" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Foreground="#8A8A94" MinWidth="48"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

            <DataGrid x:Name="NetworksGrid" Grid.Row="1"
                      SelectionChanged="NetworksGrid_SelectionChanged"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="NetworksGrid_PreviewMouseRightButtonDown"
                      ClipboardCopyMode="ExcludeHeader"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1"
                      CanUserReorderColumns="True"
                      Background="#26262E" Foreground="#E8E8EC" BorderThickness="0"
                      RowBackground="#26262E" AlternatingRowBackground="#2C2C36">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CopyCellItem" Header="{loc:Text S16}" Click="CopyCell_Click"/>
                        <MenuItem Header="{loc:Text S17}" Click="CopyRows_Click"/>
                        <MenuItem Header="{loc:Text S18}" Click="CopyTable_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Text S19}" Click="ExportTable_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Text S20}" loc:ColumnKey.Id="(E)SSID" Binding="{Binding DisplayName}" Width="170"/>
                    <DataGridTextColumn Header="{loc:Text S21}" loc:ColumnKey.Id="BSSID" Binding="{Binding Bssid}" Width="135"/>
                    <DataGridTextColumn Header="{loc:Text S22}" loc:ColumnKey.Id="Adapter" Binding="{Binding AdapterText}" Width="200"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{loc:Text S23}" loc:ColumnKey.Id="Signal (%)" Binding="{Binding SignalPercent}" Width="70"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{loc:Text S24}" loc:ColumnKey.Id="RSSI (dBm)" Binding="{Binding Rssi}" Width="80"/>
                    <DataGridTextColumn Header="{loc:Text S25}" loc:ColumnKey.Id="Ch" Binding="{Binding Channel}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Text S26}" loc:ColumnKey.Id="Width (MHz)" Binding="{Binding ChannelWidthMhz}" Width="90"/>
                    <DataGridTextColumn Header="{loc:Text S27}" loc:ColumnKey.Id="Max rate (Mbps)" Binding="{Binding MaxRateMbps, StringFormat={}{0:0.#}}" Width="110"/>
                    <DataGridTextColumn Header="{loc:Text S28}" loc:ColumnKey.Id="Freq (MHz)" Binding="{Binding FrequencyMhz}" Width="80"/>
                    <DataGridTextColumn Header="{loc:Text S29}" loc:ColumnKey.Id="Band (GHz)" Binding="{Binding BandText}" Width="80"/>
                    <DataGridTextColumn Header="{loc:Text S30}" loc:ColumnKey.Id="802.11" Binding="{Binding Standards}" Width="80"/>
                    <DataGridTextColumn Header="{loc:Text S31}" loc:ColumnKey.Id="Generation" Binding="{Binding Generation}" Width="90"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="{loc:Text S32}" loc:ColumnKey.Id="Security" Binding="{Binding SecurityText}" Width="130"/>
                    <DataGridTextColumn Header="{loc:Text S33}" loc:ColumnKey.Id="Cipher" Binding="{Binding CipherText}" Width="85"/>
                    <DataGridTextColumn Header="{loc:Text S34}" loc:ColumnKey.Id="WPS" Binding="{Binding WpsVersion}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Text S35}" loc:ColumnKey.Id="Legacy rates (Mbps)" Binding="{Binding RatesCsv}" Width="170"/>
                    <DataGridTextColumn Header="{loc:Text S36}" loc:ColumnKey.Id="Vendor" Binding="{Binding VendorText}" Width="150"/>
                    <DataGridTextColumn Header="{loc:Text S37}" loc:ColumnKey.Id="Last seen (s)" Binding="{Binding LastSeenSeconds}" Width="90"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#26262E"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Background" Value="#1F3A2A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <TabControl x:Name="GraphTabs" Grid.Row="3" Background="Transparent"
                        BorderThickness="0" Padding="0">
                <TabItem Header="2.4 GHz">
                    <controls:ChannelGraph x:Name="Graph24" Band="2.4 GHz"/>
                </TabItem>
                <TabItem Header="5 GHz">
                    <controls:ChannelGraph x:Name="Graph5" Band="5 GHz"/>
                </TabItem>
                <TabItem Header="6 GHz">
                    <controls:ChannelGraph x:Name="Graph6" Band="6 GHz"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Right column: WiFi Direct + signal graph + recommendations -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="1.4*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="{loc:Text S38}"/>
                <DataGrid x:Name="PeersGrid"
                          SelectionChanged="PeersGrid_SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          HorizontalScrollBarVisibility="Auto"
                          ClipboardCopyMode="ExcludeHeader"
                          CanUserReorderColumns="True" FontSize="11"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="PeersGrid_PreviewMouseRightButtonDown"
                          Background="#26262E" Foreground="#E8E8EC" BorderThickness="0"
                          RowBackground="#26262E" AlternatingRowBackground="#2C2C36">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Text S39}" Click="CopyPeer_Click"/>
                            <MenuItem Header="{loc:Text S40}" Click="CopyPeerList_Click"/>
                            <Separator/>
                            <MenuItem Header="{loc:Text S41}" Click="ExportPeers_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Text S42}" loc:ColumnKey.Id="Name" Binding="{Binding NameText}" Width="110"/>
                        <DataGridTextColumn Header="{loc:Text S24}" loc:ColumnKey.Id="RSSI (dBm)" Binding="{Binding SignalText}"
                                            SortMemberPath="SignalDbm" Width="75"/>
                        <DataGridTextColumn Header="{loc:Text S43}" loc:ColumnKey.Id="Type" Binding="{Binding DeviceTypeText}" Width="85"/>
                        <DataGridTextColumn Header="{loc:Text S44}" loc:ColumnKey.Id="Paired" Binding="{Binding PairedText}" Width="50"/>
                        <DataGridTextColumn Header="{loc:Text S36}" loc:ColumnKey.Id="Vendor" Binding="{Binding VendorText}" Width="110"/>
                        <DataGridTextColumn Header="{loc:Text S45}" loc:ColumnKey.Id="MAC" Binding="{Binding Address}" Width="115"/>
                        <DataGridTextColumn Header="{loc:Text S37}" loc:ColumnKey.Id="Last seen (s)" Binding="{Binding LastSeenSeconds}" Width="80"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#26262E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="{loc:Text S46}"/>
                <controls:SignalGraph x:Name="SignalGraphView"
                                      ContextMenuOpening="SignalGraph_ContextMenuOpening">
                    <controls:SignalGraph.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="ExportHistoryItem"
                                      Header="{loc:Text S47}"
                                      Click="ExportHistory_Click"/>
                        </ContextMenu>
                    </controls:SignalGraph.ContextMenu>
                </controls:SignalGraph>
            </DockPanel>

            <DockPanel Grid.Row="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="{loc:Text S48}"/>
                <Border Background="#26262E" Padding="10">
                    <TextBox x:Name="AdviceText" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             Text="{loc:Text S49}"/>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#26262E"
                Padding="10,5" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="StatsText" DockPanel.Dock="Right"
                           Foreground="#8A8A94" Text=""/>
                <TextBlock x:Name="StatusText" Foreground="#8A8A94" Text="{loc:Text S50}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
